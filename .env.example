# ============================================================
# model_answer 環境変数テンプレート
# 使い方: `cp .env.example .env` したあと、必要ならローカルで値を編集する。
# .env ファイル自体は .gitignore に含まれ、コミット対象外になる。
# docker-compose.yml が `env_file: .env` で参照するため、ファイル名は固定。
# ============================================================

# --- PostgreSQL (model_answer_db サービスが参照) --------------
# postgres:16-alpine 公式イメージが初回起動時に以下 3 変数で
# スーパーユーザーと初期 DB を作成する（/docker-entrypoint-initdb.d/ の仕組み）。
# UI ツール(DBeaver / pgAdmin / A5:SQL 等)からは host=localhost port=5432
# 以下の user/password/db で接続できる（docker-compose.yml でホスト公開する）。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# --- backend → db 接続 URL (Phase1 以降で使用) ----------------
# psycopg 形式: postgresql://<user>:<pass>@<host>:<port>/<db>
# <host> は docker compose のサービス名 model_answer_db を
# Docker の内部 DNS で解決してコンテナ間接続するために使う。
# Phase0 時点ではコード側で未参照だが、Phase1 の接続実装に向けて先置きする。
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/schedule_manager

# --- Flask 起動オプション -------------------------------------
# 1 にすると Flask が開発モード（自動リロード・詳細エラー）で起動する。
# 本番相当にしたい場合は 0 または未設定にする。
FLASK_DEBUG=1

# --- frontend → backend 呼び出し URL --------------------------
# ブラウザ側 JavaScript から見たアドレスなので、compose のサービス名ではなく
# ホスト側に公開された localhost:8000 を指定する。Phase0 時点では未参照。
VITE_API_BASE_URL=http://localhost:8000

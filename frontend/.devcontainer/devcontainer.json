// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "frontend",
	"dockerComposeFile": [
		"../../docker-compose.yml"
	],
	// serviceはdevcontainerを起動する際にアタッチするサービスを指定する。今回はフロントエンドのコンテナにアタッチするため、frontendを指定する
	"service": "frontend",
	"workspaceFolder": "/workspace/frontend",
	// runServicesはdevcontainerを起動する際に同時に起動する他サービスを指定する。今回はフロントエンドとバックエンドのコンテナを起動するため、frontendとbackendを指定する
	"runServices": [
		"backend",
		"postgres"
	]
	// "postCreateCommand": "npm run dev"
}